<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/container_bg"
    app:skinnable="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/demo_primary"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:skinnable="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Skinnable Demo"
            app:titleTextColor="@android:color/white" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/demo_primary"
            app:tabIndicatorColor="@color/demo_surface"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/demo_surface"
            app:tabTextColor="@color/demo_tab_unselected"
            app:skinnable="true">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认 (Default)" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="内置 (Built-in)" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="前缀内置 (Prefix)" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/fragment_container"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态用户主题 (SkinUserThemeManager) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/demo_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:skinnable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨 用户动态调色盘 (SkinUserThemeManager)"
                        android:textColor="@color/demo_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:skinnable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="实时修改 Theme 资源颜色（无需皮肤包）"
                        android:textColor="@color/demo_hint"
                        android:textSize="13sp"
                        app:skinnable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnThemePink"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="粉色"
                            android:textSize="12sp"
                            app:strokeColor="@color/demo_primary" />

                        <Button
                            android:id="@+id/btnThemeGreen"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="绿色"
                            android:textSize="12sp"
                            app:strokeColor="@color/demo_primary" />

                        <Button
                            android:id="@+id/btnThemePurple"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="紫色"
                            android:textSize="12sp"
                            app:strokeColor="@color/demo_primary" />

                        <Button
                            android:id="@+id/btnThemeReset"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="重置"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 协程异步换肤 (loadSkinSuspend) -->
            <Button
                android:id="@+id/btnAsyncSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/demo_primary"
                android:text="⚡ 协程异步换肤 (Coroutines loadSkinSuspend)"
                android:textColor="@android:color/white"
                app:skinnable="true" />

            <!-- Jetpack Compose 换肤示范 (SkinnableTheme) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/demo_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:skinnable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚛️ Jetpack Compose 换肤 (SkinnableTheme)"
                        android:textColor="@color/demo_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:skinnable="true" />

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/composeView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CardView (Material) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/demo_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:skinnable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material CardView"
                        android:textColor="@color/demo_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:skinnable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="This is a skinnable CardView displaying skinnable text, buttons, and icons."
                        android:textColor="@color/demo_hint"
                        android:textSize="14sp"
                        app:skinnable="true" />

                    <!-- Widgets Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@color/container_bg"
                            android:padding="8dp"
                            android:src="@drawable/ic_assignment_turned_in_black_24dp"
                            app:skinnable="true"
                            app:tint="@color/demo_icon_tint" />

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:checked="true"
                            android:text="Check"
                            android:textColor="@color/demo_text"
                            app:buttonTint="@color/demo_primary"
                            app:skinnable="true" />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:checked="true"
                            android:text="Radio"
                            android:textColor="@color/demo_text"
                            app:buttonTint="@color/demo_primary"
                            app:skinnable="true" />
                    </LinearLayout>

                    <!-- Input and Button -->
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/demo_primary"
                        android:hint="Type something here..."
                        android:textColor="@color/demo_text"
                        android:textColorHint="@color/demo_hint"
                        app:skinnable="true" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/demo_primary"
                        android:text="Submit Action"
                        android:textColor="@android:color/white"
                        app:skinnable="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ProgressBar Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Progress Elements"
                android:textColor="@color/demo_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:skinnable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="50"
                    android:progressTint="@color/demo_primary"
                    app:skinnable="true" />

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:indeterminateTint="@color/demo_primary"
                    app:skinnable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_text1"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/text_background"
                android:gravity="center_vertical"
                android:text="Dynamic Skin Action Button 1"
                android:textColor="@color/text_color"
                android:textSize="15sp"
                android:paddingStart="16dp"
                app:drawableLeftCompat="@drawable/ic_assignment_turned_in_black_24dp"
                app:drawableStartCompat="@drawable/ic_assignment_turned_in_black_24dp"
                app:skinnable="true" />

            <com.util.skinnable.support.compat.widget.SkinCompatTextView
                android:id="@+id/tv_text2"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginTop="15dp"
                android:background="@color/text_background"
                android:drawableStart="@drawable/ic_assignment_turned_in_black_24dp"
                android:gravity="center_vertical"
                android:text="Dynamic Skin Action Button 2"
                android:textColor="@color/text_color"
                android:textSize="15sp"
                android:paddingStart="16dp"
                app:skinnable="true" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        app:backgroundTint="@color/demo_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:skinnable="true"
        app:srcCompat="@drawable/ic_assignment_turned_in_black_24dp"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>